{
  "name": "internship-board-api",
  "version": "1.0.0",
  "description": "Production-minded REST API for an Internship Board built with Node.js, Express, and SQLite",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules vitest"
  },
  "keywords": ["internship", "api", "rest", "express", "sqlite"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.12.0",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "supertest": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
